{
  "name": "admissions-backend",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:push": "drizzle-kit push",
    "seed": "node src/seed.js",
    "test": "node src/services/domain/selection.test.js && node src/services/domain/importMap.test.js && node src/services/domain/revert.test.js && node src/common/security.test.js",
    "seed:sample": "node src/seed.js --sample",
    "db:upgrade": "node src/dbUpgrade.js",
    "db:cleanup": "node src/dbCleanup.js",
    "db:deploy": "node src/dbCleanup.js && drizzle-kit push && node src/dbUpgrade.js && node src/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0"
  },
  "engines": {
    "node": ">=20"
  }
}
