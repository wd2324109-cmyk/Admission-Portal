# Copy to .env and fill in. NEVER commit .env or share it (zip, chat, screenshots).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# true for a database reached over the internet; false only for a private/internal address
DATABASE_SSL=true

# Required. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Production refuses to start if this is empty, under 32 characters, or a typed phrase.
JWT_SECRET=

# First-run logins (used once by `npm run seed`; change after first sign-in)
SEED_ADMIN_PASSWORD=
SEED_STATE_PASSWORD=

PORT=4000
NODE_ENV=production
# true when behind nginx / Render, so rate limits see the real visitor IP
TRUST_PROXY=true
# Only if the website is served from a different address than the API. Exact origins, comma-separated, never *
#CORS_ORIGIN=https://your-site.example
#SESSION_IDLE_MINUTES=30
# Rate limits per IP per minute (defaults shown)
#API_RATE_LIMIT_PER_MIN=2000
#HEAVY_RATE_LIMIT_PER_MIN=60
