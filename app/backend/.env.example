DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_SSL=true
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
SEED_ADMIN_PASSWORD=choose-a-strong-password
PORT=4000
NODE_ENV=production
# Your site address (comma-separated if several). Not needed when the frontend proxies /api to this server.
CORS_ORIGIN=https://your-site.example
TRUST_PROXY=true
# Minutes of inactivity before a device is signed out (default 30)
#SESSION_IDLE_MINUTES=30
